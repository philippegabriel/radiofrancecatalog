#!/usr/bin/env bash
set -euo pipefail
project_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
exec "$project_root/data/llama.cpp/build/bin/llama-server" \
  --model "$project_root/data/llama.cpp/multilingual-e5-small-f32.gguf" \
  --alias intfloat/multilingual-e5-small \
  --embedding --pooling mean --embd-normalize 2 \
  --ctx-size 512 --batch-size 512 --ubatch-size 512 --parallel 1 \
  --threads "${RF_EMBEDDING_THREADS:-4}" \
  --host "${RF_EMBEDDING_HOST:-127.0.0.1}" --port "${RF_EMBEDDING_PORT:-8081}"
